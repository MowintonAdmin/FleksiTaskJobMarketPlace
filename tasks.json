{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. 启动 Backend (FastAPI)",
      "type": "shell",
      "command": "powershell -Command \"cd backend; .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000\"",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "2. 启动 Admin 前端 (Port 3000)",
      "type": "shell",
      "command": "powershell -Command \"cd frontend/admin; npm run dev\"",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "3. 启动 Worker Web 前端 (Port 3001)",
      "type": "shell",
      "command": "powershell -Command \"cd frontend/web; npm run dev\"",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "⚡ 一键同时启动所有服务 (FlekxiTask 全栈应用)",
      "dependsOn": [
        "1. 启动 Backend (FastAPI)",
        "2. 启动 Admin 前端 (Port 3000)",
        "3. 启动 Worker Web 前端 (Port 3001)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}